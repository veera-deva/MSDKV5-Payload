<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/activity_background">

    <!-- ===== LEFT CONTROL PANEL ===== -->
    <LinearLayout
        android:id="@+id/ll_left_panel"
        android:layout_width="320dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="@color/black_half"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:background="#CC1A1A2E"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:src="@android:drawable/ic_media_previous"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="@color/white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Speaker Payload"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginEnd="48dp" />
        </LinearLayout>

        <!-- Connection status row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:background="#881A1A2E"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ports: "
                android:textColor="@color/lighter_gray"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_connection_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Checking..."
                android:textColor="@color/white"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gray_divider_line" />

        <!-- Megaphone State -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Speaker State"
                android:textColor="@color/lighter_gray"
                android:textSize="13sp"
                android:layout_centerVertical="true" />

            <TextView
                android:id="@+id/tv_megaphone_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="N/A"
                android:textColor="@color/blue"
                android:textSize="13sp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true" />
        </RelativeLayout>

        <!-- Speaker Index -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Speaker"
                android:textColor="@color/lighter_gray"
                android:textSize="13sp"
                android:layout_centerVertical="true" />

            <TextView
                android:id="@+id/tv_cur_megaphone_index"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="N/A"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/sp_megaphone_switch"
                android:layout_marginEnd="8dp" />

            <Spinner
                android:id="@+id/sp_megaphone_switch"
                android:layout_width="80dp"
                android:layout_height="26dp"
                android:background="@drawable/bg_stroke_common_with_color"
                android:dropDownWidth="130dp"
                android:entries="@array/megaphone_index_array"
                android:spinnerMode="dropdown"
                android:textColor="@color/white"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true" />
        </RelativeLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gray_divider_line"
            android:layout_marginTop="12dp" />

        <!-- Volume label + value -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Volume"
                android:textColor="@color/lighter_gray"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_volume_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="50"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:layout_alignParentEnd="true" />
        </RelativeLayout>

        <SeekBar
            android:id="@+id/sb_volume_control"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="50" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gray_divider_line"
            android:layout_marginTop="10dp" />

        <!-- Playback controls row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="10dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Playback"
                android:textColor="@color/lighter_gray"
                android:textSize="13sp"
                android:gravity="center_vertical" />

            <ImageButton
                android:id="@+id/btn_play_mode"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_action_playback_repeat"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_marginEnd="8dp"
                android:scaleType="fitXY" />

            <ImageButton
                android:id="@+id/btn_play_control"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_media_play"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="fitXY" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gray_divider_line"
            android:layout_marginTop="10dp" />

        <!-- Upload status -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Upload Status"
            android:textColor="@color/lighter_gray"
            android:textSize="12sp"
            android:layout_marginTop="10dp"
            android:layout_marginStart="14dp" />

        <TextView
            android:id="@+id/tv_upload_status"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text=""
            android:textColor="@color/white"
            android:textSize="11sp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp" />

    </LinearLayout>

    <!-- Vertical divider -->
    <View
        android:id="@+id/v_divider"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:background="@color/gray_divider_line"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/ll_left_panel" />

    <!-- ===== RIGHT CONTENT PANEL — Record Voice ===== -->
    <LinearLayout
        android:id="@+id/ll_right_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="@color/black_medium"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/v_divider"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Section header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#CC1A1A2E"
            android:paddingStart="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Voice Recording"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Record fragment fills remaining space -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
