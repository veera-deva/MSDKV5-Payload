<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_medium"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <!-- Section title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Voice Recording"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Record your voice and play it through the drone speaker"
            android:textColor="@color/lighter_gray"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Microphone button + pulse ring -->
        <FrameLayout
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center_horizontal">

            <!-- Pulse ring (animated via alpha) -->
            <View
                android:id="@+id/v_pulse_ring"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_record_pulse_ring"
                android:alpha="0" />

            <!-- Main mic FAB -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btn_record"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:src="@drawable/ic_mic_white_36dp"
                android:tint="@color/green"
                android:backgroundTint="@color/dark_gray"
                app:fabSize="auto" />
        </FrameLayout>

        <!-- Recording status text -->
        <TextView
            android:id="@+id/tv_record_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to Start Recording"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="16dp" />

        <!-- Timer / Chronometer -->
        <Chronometer
            android:id="@+id/chronometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="36sp"
            android:textColor="@color/white"
            android:fontFamily="sans-serif-light"
            android:gravity="center"
            android:layout_marginTop="8dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gray_light_divider_line"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp" />

        <!-- Upload progress section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Upload to Speaker"
                    android:textColor="@color/lighter_gray"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_bytes_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/lighter_gray"
                    android:textSize="11sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/upload_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/blue"
                android:progressBackgroundTint="@color/gray_medium" />

            <TextView
                android:id="@+id/tv_upload_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tap mic to start recording"
                android:textColor="@color/lighter_gray"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gray_light_divider_line"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp" />

        <!-- Quick play option -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <CheckBox
                android:id="@+id/cb_quick_play"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:buttonTint="@color/blue"
                android:text="Auto-play when upload completes" />
        </LinearLayout>

        <!-- Speaker playback controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btn_play_on_speaker"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Play on Speaker"
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:background="@drawable/btn_bg_stroke_common_with_color"
                android:enabled="false" />

            <Button
                android:id="@+id/btn_stop_speaker"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Stop Speaker"
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:background="@drawable/btn_bg_stroke_common_with_color"
                android:enabled="false" />
        </LinearLayout>

        <!-- Help text -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Audio is encoded in Opus format and streamed to the connected speaker payload in real time. Use the speaker controls on the left panel to adjust volume and playback mode."
            android:textColor="@color/while_60"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</ScrollView>
